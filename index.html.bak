<script>
(function () {
  const canvas = document.getElementById('bg-canvas');
  if (!canvas || typeof THREE === 'undefined') return;

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.setSize(window.innerWidth, window.innerHeight, false);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
  camera.position.z = 6;

  const ACCENT = 0xa78bfa, VERTEX = 0xe9d5ff;
  const geoms = [
    new THREE.IcosahedronGeometry(0.28, 0),
    new THREE.OctahedronGeometry(0.30, 0),
    new THREE.TetrahedronGeometry(0.32, 0),
    new THREE.IcosahedronGeometry(0.22, 0),
    new THREE.OctahedronGeometry(0.26, 0),
    new THREE.TetrahedronGeometry(0.28, 0),
    new THREE.IcosahedronGeometry(0.20, 0),
    new THREE.OctahedronGeometry(0.24, 0),
    new THREE.TetrahedronGeometry(0.26, 0),
  ];

  const objects = [];
  geoms.forEach((geo) => {
    const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
      color: ACCENT, wireframe: true, transparent: true, opacity: 0.4
    }));
    const pg = new THREE.BufferGeometry();
    pg.setAttribute('position', geo.attributes.position.clone());
    mesh.add(new THREE.Points(pg, new THREE.PointsMaterial({
      color: VERTEX, size: 0.04, sizeAttenuation: true, transparent: true, opacity: 0.6
    })));
    mesh.userData = {
      base: new THREE.Vector3((Math.random() - 0.5) * 10, (Math.random() - 0.5) * 8, (Math.random() - 0.5) * 3 - 1),
      rotX: (Math.random() - 0.5) * 0.006,
      rotY: (Math.random() - 0.5) * 0.008,
      phase: Math.random() * Math.PI * 2,
      wobbleAmp: 0.3 + Math.random() * 0.4,
      wobbleFreq: 0.15 + Math.random() * 0.2,
    };
    mesh.position.copy(mesh.userData.base);
    scene.add(mesh);
    objects.push(mesh);
  });

  let t = 0;
  function animate() {
    requestAnimationFrame(animate);
    t += 0.004;
    objects.forEach((obj) => {
      const d = obj.userData;
      obj.position.x = d.base.x + Math.sin(t * d.wobbleFreq + d.phase) * d.wobbleAmp;
      obj.position.y = d.base.y + Math.cos(t * d.wobbleFreq * 0.8 + d.phase) * d.wobbleAmp * 0.8;
      obj.position.z = d.base.z + Math.sin(t * 0.12 + d.phase) * 0.4;
      obj.rotation.x += d.rotX;
      obj.rotation.y += d.rotY;
    });
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight, false);
  });
})();

(function () {
  const USERNAME = 'JiamingShi-JsPhys';
  const grid = document.getElementById('contrib-grid');
  const countEl = document.getElementById('contrib-count');
  const overlay = document.getElementById('wave-overlay');
  if (!grid || !overlay) return;

  const WEEKS = 52, DAYS = 7;
  const wctx = overlay.getContext('2d');

  const SIGMA = 3.6;
  const GLOW_THRESHOLD = 0.12;
  const SPEED = 4.0;
  const WAVELENGTH_COLS = 3.2;
  const EDGE_FADE_COLS = 2.5;

  async function fetchContribs() {
    const url = `https://github-contributions-api.jogruber.de/v4/${USERNAME}?y=last`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('fetch failed');
    const data = await res.json();
    return data.contributions;
  }

  function fallbackData() {
    const out = [];
    const today = new Date();
    for (let i = 364; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(d.getDate() - i);
      const day = d.getDay();
      const isWeekend = (day === 0 || day === 6);
      const r = Math.random();
      const base = isWeekend ? 0.2 : 0.55;
      const v = base + r * 0.5 - 0.2;
      let level = 0;
      if (v > 0.75) level = 4;
      else if (v > 0.55) level = 3;
      else if (v > 0.35) level = 2;
      else if (v > 0.15) level = 1;
      out.push({ date: d.toISOString().slice(0, 10), count: level, level });
    }
    return out;
  }

  function groupByWeek(contribs) {
    const weeks = Array.from({ length: WEEKS }, () => Array(DAYS).fill(null));
    const byDate = {};
    contribs.forEach(c => { byDate[c.date] = c; });

    const today = new Date();
    const todayDow = today.getDay();
    const lastSunday = new Date(today);
    lastSunday.setDate(today.getDate() - todayDow);
    const start = new Date(lastSunday);
    start.setDate(start.getDate() - (WEEKS - 1) * 7);

    for (let w = 0; w < WEEKS; w++) {
      for (let d = 0; d < DAYS; d++) {
        const date = new Date(start);
        date.setDate(start.getDate() + w * 7 + d);
        const key = date.toISOString().slice(0, 10);
        weeks[w][d] = byDate[key] || { date: key, count: 0, level: 0 };
      }
    }
    return weeks;
  }

  let cellsByWeek = [];
  function renderGrid(weeks) {
    grid.innerHTML = '';
    cellsByWeek = [];
    let total = 0;
    for (let w = 0; w < WEEKS; w++) {
      const col = document.createElement('div');
      col.className = 'contrib-col';
      const colCells = [];
      for (let d = 0; d < DAYS; d++) {
        const cell = document.createElement('div');
        cell.className = 'contrib-cell';
        const item = weeks[w][d];
        cell.dataset.level = item.level || 0;
        cell.title = `${item.date}: ${item.count} contribution${item.count === 1 ? '' : 's'}`;
        col.appendChild(cell);
        colCells.push(cell);
        total += item.count || 0;
      }
      grid.appendChild(col);
      cellsByWeek.push(colCells);
    }
    countEl.classList.remove('loading');
    countEl.textContent = `${total} contributions`;
  }

  let colCentersX = [];
  function computeColCenters() {
    const overlayRect = overlay.getBoundingClientRect();
    colCentersX = [];
    for (let w = 0; w < WEEKS; w++) {
      const cell = cellsByWeek[w] && cellsByWeek[w][0];
      if (!cell) { colCentersX.push(0); continue; }
      const r = cell.getBoundingClientRect();
      colCentersX.push(r.left + r.width / 2 - overlayRect.left);
    }
  }

  let waveX = -8;
  let lastTime = 0;

  function edgeFade(x) {
    const left = Math.max(0, Math.min(1, x / EDGE_FADE_COLS));
    const right = Math.max(0, Math.min(1, (WEEKS - x) / EDGE_FADE_COLS));
    return Math.min(left, right);
  }

  function updateGlow() {
    for (let w = 0; w < WEEKS; w++) {
      const dist = w - waveX;
      let intensity = Math.exp(-(dist * dist) / (2 * SIGMA * SIGMA));
      intensity *= edgeFade(waveX);
      const cells = cellsByWeek[w];
      if (!cells) continue;
      if (intensity > GLOW_THRESHOLD) {
        cells.forEach(c => {
          if (!c.classList.contains('glowing')) c.classList.add('glowing');
        });
      } else {
        cells.forEach(c => c.classList.remove('glowing'));
      }
    }
  }

  function drawWave() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const rect = overlay.getBoundingClientRect();
    const w = rect.width, h = rect.height;
    if (overlay.width !== Math.round(w * dpr) || overlay.height !== Math.round(h * dpr)) {
      overlay.width = Math.round(w * dpr);
      overlay.height = Math.round(h * dpr);
      wctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    wctx.clearRect(0, 0, w, h);

    if (colCentersX.length < 2) return;
    const colStep = colCentersX[1] - colCentersX[0];
    if (colStep <= 0) return;

    const centerY = h / 2;
    const amplitude = h * 0.36;
    const sigmaPx = SIGMA * colStep;
    const lambdaPx = WAVELENGTH_COLS * colStep;

    const clampedX = Math.max(0, Math.min(WEEKS - 1, waveX));
    const i0 = Math.floor(clampedX);
    const i1 = Math.min(WEEKS - 1, i0 + 1);
    const frac = clampedX - i0;
    const waveCenterX = colCentersX[i0] * (1 - frac) + colCentersX[i1] * frac;

    const fade = edgeFade(waveX);

    const points = [];
    const stepPx = 1.5;
    for (let x = 0; x <= w; x += stepPx) {
      const dx = x - waveCenterX;
      const env = Math.exp(-(dx * dx) / (2 * sigmaPx * sigmaPx));
      const y = centerY - env * amplitude * fade * Math.cos((2 * Math.PI * dx) / lambdaPx);
      points.push([x, y]);
    }

    wctx.beginPath();
    wctx.moveTo(0, centerY);
    points.forEach(([x, y]) => wctx.lineTo(x, y));
    wctx.lineTo(w, centerY);
    wctx.closePath();
    wctx.fillStyle = `rgba(167, 139, 250, ${0.04 * fade})`;
    wctx.fill();

    wctx.beginPath();
    points.forEach(([x, y], i) => {
      if (i === 0) wctx.moveTo(x, y);
      else wctx.lineTo(x, y);
    });
    wctx.strokeStyle = `rgba(167, 139, 250, ${0.30 * fade})`;
    wctx.lineWidth = 1.3;
    wctx.stroke();

    wctx.beginPath();
    wctx.moveTo(0, centerY);
    wctx.lineTo(w, centerY);
    wctx.strokeStyle = `rgba(167, 139, 250, ${0.05 * fade})`;
    wctx.lineWidth = 1;
    wctx.setLineDash([3, 4]);
    wctx.stroke();
    wctx.setLineDash([]);
  }

  function tick(now) {
    if (!lastTime) lastTime = now;
    const dt = (now - lastTime) / 1000;
    lastTime = now;

    waveX += SPEED * dt;
    if (waveX > WEEKS + EDGE_FADE_COLS + 2) waveX = -EDGE_FADE_COLS - 2;

    updateGlow();
    drawWave();
    requestAnimationFrame(tick);
  }

  (async () => {
    let contribs;
    try {
      contribs = await fetchContribs();
    } catch (e) {
      contribs = fallbackData();
      countEl.textContent = 'API Failed';
    }
    const weeks = groupByWeek(contribs);
    renderGrid(weeks);

    requestAnimationFrame(() => {
      computeColCenters();
      requestAnimationFrame(tick);
    });

    window.addEventListener('resize', () => {
      computeColCenters();
    });
  })();
})();

(async function() {
  const container = document.getElementById('projects-container');
  const username = 'JiamingShi-JsPhys';
  
  const fallbackRepos = [
    {
      name: 'agent-skills',
      description: 'A growing collection of standalone agent skills by Jiaming Shi. Each folder is a self-contained Skill package — its own SKILL.md, README,...'
    },
    {
      name: 'agent-emergence',
      description: 'Js_Emergence, by Jiaming Shi, is the front door to tools. It unifies the skills inside Js_Agent-Skills: you ask, it finds the right tool...'
    },
    {
      name: 'chem-notes',
      description: 'A self-contained set of General Chemistry lecture notes, typeset in LaTeX. It takes a physics-first, axiomatic approach rather than asser...'
    }
  ];

  function renderCards(repos) {
    repos.sort((a, b) => {
      const starsA = a.stars || a.stargazers_count || 0;
      const starsB = b.stars || b.stargazers_count || 0;
      if (starsB !== starsA) {
        return starsB - starsA;
      }
      return a.name.localeCompare(b.name);
    });

    const displayRepos = repos.slice(0, 4);

    container.innerHTML = displayRepos.map(repo => {
      let desc = repo.description || 'No description provided.';
      if (desc.length > 120) desc = desc.substring(0, 120) + '...';
      desc = desc.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      
      const finalUrl = `https://github.com/${username}/${repo.name}`;

      return `
        <a href="${finalUrl}" target="_blank" rel="noopener noreferrer" class="project-card">
          <div class="project-title">${repo.name}</div>
          <div class="project-desc">${desc}</div>
        </a>
      `;
    }).join('');
  }

  try {
    const res = await fetch(`https://pinned.berrysauce.dev/get/${username}`);
    if (!res.ok) throw new Error('Pinned API failed');
    const pinnedRepos = await res.json();
    
    if (pinnedRepos && Array.isArray(pinnedRepos) && pinnedRepos.length > 0) {
      renderCards(pinnedRepos);
    } else {
      throw new Error('No pinned repos found');
    }
  } catch (e) {
    try {
      const res = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=100`);
      if (!res.ok) throw new Error('GitHub API failed');
      const repos = await res.json();
      
      if (Array.isArray(repos)) {
          const filtered = repos.filter(r => !r.fork && r.name.toLowerCase() !== username.toLowerCase());
          if (filtered.length > 0) {
            renderCards(filtered);
          } else {
            renderCards(fallbackRepos);
          }
      } else {
          renderCards(fallbackRepos);
      }
    } catch (err) {
      renderCards(fallbackRepos);
    }
  }
})();
</script>
</body>
</html>
