<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jiaming Shi · Profile</title>
<style>
  :root {
    --bg: #0d1117;
    --bg-alt: #161b22;
    --bg-card: #0f141b;
    --border: #21262d;
    --border-accent: #4a3a7a;
    --text: #c9d1d9;
    --text-dim: #8b949e;
    --accent: #a78bfa;
    --accent-dim: #7c3aed;
    --accent-gold: #e0a458;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    font-size: 16px; line-height: 1.6;
    overflow-x: hidden;
  }
  #bg-canvas {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: 0; pointer-events: none; opacity: 0.5;
  }
  .container {
    position: relative; z-index: 1;
    max-width: 980px; margin: 0 auto; padding: 0 32px 80px;
  }
  .header-img { width: calc(100% + 64px); margin-left: -32px; display: block; }
  .typing-wrap { display: flex; justify-content: center; margin: -28px 0 24px; }

  .identity { text-align: center; margin: 24px 0 20px; position: relative; }
  .identity .avatar {
    width: 112px; height: 112px;
    border-radius: 50%;
    display: block;
    margin: 0 auto 14px;
    object-fit: cover;
    border: 2px solid var(--border-accent);
    box-shadow:
      0 0 0 4px rgba(13, 17, 23, 1),
      0 0 24px 4px rgba(167, 139, 250, 0.18);
    background: var(--bg-alt);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .identity .avatar:hover {
    transform: scale(1.04);
    border-color: var(--accent);
    box-shadow:
      0 0 0 4px rgba(13, 17, 23, 1),
      0 0 32px 6px rgba(167, 139, 250, 0.32);
  }
  .identity .name {
    font-size: 30px; font-weight: 700;
    letter-spacing: 0.02em; color: var(--text); line-height: 1.3;
  }
  .identity .affiliation {
    font-size: 15px; color: var(--text-dim);
    margin-top: 8px; letter-spacing: 0.02em;
  }

  h2 {
    font-size: 17px; font-weight: 600; color: var(--text);
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px; margin: 44px 0 18px; letter-spacing: 0.03em;
    display: flex; align-items: center; gap: 10px;
  }
  
  .section-icon {
    width: 22px; height: 22px;
    color: var(--accent);
    transition: transform 0.4s ease, color 0.3s ease;
  }
  h2:hover .section-icon {
    transform: rotate(15deg) scale(1.1);
    color: var(--accent-gold);
  }

  p { margin: 12px 0; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  ul { padding-left: 20px; margin: 8px 0; }
  li { margin: 6px 0; }

  .focus-card {
    background: var(--bg-card);
    border: 1px solid var(--border-accent);
    border-radius: 12px;
    padding: 20px 24px 18px;
    margin: 18px 0;
    position: relative;
  }
  .focus-header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-accent);
    position: relative;
  }
  .focus-header .title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .focus-header .path {
    font-size: 13px;
    color: var(--text-dim);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.02em;
  }
  .focus-header::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-gold) 100%);
    opacity: 0.55;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .focus-item {
    background: rgba(255,255,255,0.015);
    border: 1px solid var(--border-accent);
    border-radius: 8px;
    padding: 12px 16px;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
    position: relative;
  }
  .focus-item:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    background: rgba(167, 139, 250, 0.04);
  }
  .focus-item.span-2 { grid-column: span 2; }
  .focus-item .num {
    position: absolute;
    top: 12px; right: 16px;
    font-size: 12px;
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--accent);
    letter-spacing: 0.05em;
    opacity: 0.85;
  }
  .focus-item.gold .num { color: var(--accent-gold); }
  .focus-item .label {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
    letter-spacing: 0.01em;
  }
  .focus-item .desc {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.55;
  }
  @media (max-width: 640px) {
    .focus-grid { grid-template-columns: 1fr; }
    .focus-item.span-2 { grid-column: span 1; }
  }

  .contrib-wrap {
    background: var(--bg-alt); border: 1px solid var(--border); border-radius: 10px;
    padding: 20px 24px; margin: 18px 0;
  }
  .contrib-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 14px; font-size: 14px; color: var(--text-dim);
  }
  .contrib-header .title { color: var(--text); font-weight: 500; }
  .contrib-grid-wrap { position: relative; width: 100%; }
  .contrib-grid {
    display: flex; gap: 3px; position: relative; width: 100%;
  }
  #wave-overlay {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none; z-index: 4;
  }
  .contrib-col { display: flex; flex-direction: column; gap: 3px; flex: 1; }
  .contrib-cell {
    width: 100%; aspect-ratio: 1 / 1;
    border-radius: 3px; background: #161b22;
    transition: background 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
  }
  .contrib-cell[data-level="0"] { background: #161b22; }
  .contrib-cell[data-level="1"] { background: #2d1b69; }
  .contrib-cell[data-level="2"] { background: #5b21b6; }
  .contrib-cell[data-level="3"] { background: #7c3aed; }
  .contrib-cell[data-level="4"] { background: #a78bfa; }
  .contrib-cell.glowing {
    box-shadow:
      0 0 3px 1px rgba(167, 139, 250, 0.28),
      0 0 6px 2px rgba(124, 58, 237, 0.12);
    transform: scale(1.06);
    z-index: 3;
    filter: brightness(1.06);
  }
  .contrib-legend {
    display: flex; justify-content: flex-end; align-items: center;
    gap: 4px; margin-top: 12px; font-size: 12px; color: var(--text-dim);
  }
  .contrib-legend .contrib-cell { width: 12px; height: 12px; aspect-ratio: auto; }
  .loading { font-size: 12px; color: var(--text-dim); }

  .project-card {
    display: block; 
    text-decoration: none; 
    color: inherit; 
    border: 1px solid var(--border); 
    border-radius: 8px;
    padding: 16px 20px; 
    margin: 12px 0; 
    background: var(--bg-alt);
    transition: border-color 0.2s, transform 0.2s;
  }
  .project-card:hover { 
    border-color: var(--accent); 
    transform: translateY(-2px); 
    text-decoration: none; 
  }
  .project-title { 
    font-weight: 600; 
    font-size: 15px; 
    color: var(--text);
    transition: color 0.2s;
  }
  .project-card:hover .project-title {
    color: var(--accent);
  }
  .project-desc { font-size: 14px; color: var(--text-dim); margin-top: 6px; }

  .contact {
    display: flex; justify-content: center; margin: 20px 0; 
    background: rgba(13, 17, 23, 0.7); 
    backdrop-filter: blur(8px); 
    padding: 24px; 
    border-radius: 8px; 
  }
  .contact-links {
    display: flex; gap: 32px; flex-wrap: wrap; justify-content: center;
  }
  .contact-links a { 
    display: inline-flex; align-items: center; gap: 10px; font-size: 15px; color: var(--text-dim);
    transition: color 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .contact-links a:hover {
    color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .contact-icon {
    width: 20px; height: 20px;
  }

  .footer-note { text-align: center; color: var(--text-dim); font-size: 13px; margin-top: 56px; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
</style>

<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
